# ==============================================================================
# Mohalla Store - Backend Environment Configuration
# ==============================================================================

# Server Configuration
PORT=8085
ALLOWED_ORIGIN=*

# Production CORS Allowed Origins (comma-separated list of allowed origins)
# Example for production: ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,https://YOUR_PRODUCTION_DOMAIN
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:3000

# ==============================================================================
# Production Persistence & Cloud Configuration
# ==============================================================================
# When USE_FIRESTORE=true or DISABLE_SQLITE_FALLBACK=true, all SQLite writes
# and queries are bypassed, making Google Cloud Firestore the pure source of truth.
USE_FIRESTORE=true
DISABLE_SQLITE_FALLBACK=true

# Storage Provider Configuration (default: local filesystem)
# Future options: firebase, cloudinary
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
DISABLE_LOCAL_STORAGE_FALLBACK=false


# JWT Authentication
# Replace with a strong, unpredictable random string in production
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# ==============================================================================
# Firebase / Google Cloud Configuration (Phase 1)
# ==============================================================================

# Option A: Path to service account JSON key file (Recommended for local dev)
# Place your downloaded Firebase service account JSON key in the backend directory
# (e.g. backend/serviceAccountKey.json) and set the path below.
# Note: serviceAccountKey.json is automatically ignored by Git.
FIREBASE_CREDENTIALS=./serviceAccountKey.json

# Option B: Raw Service Account JSON content (Useful for container/CI deployments)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Firebase Project ID
FIREBASE_PROJECT_ID=mohalla-store

# Firebase Cloud Storage Bucket Name
# Typically: <project-id>.appspot.com or <project-id>.firebasestorage.app
FIREBASE_STORAGE_BUCKET=mohalla-store.appspot.com
